<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ohseat.ohseatback.repository.RecommendRepository">
    <select id="getCinemaList" resultType="com.ohseat.ohseatback.domain.Recommend">
        SELECT cinema_id, area_id, multiplex_id, cinema_name
        FROM cinema
        WHERE multiplex_id = #{multiplexId}
        AND area_id = #{areaId}
    </select>
</mapper>
